DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
# Runtime Node only. Configure the official Supabase CA as a server-only PEM value.
SUPABASE_DB_CA_CERT=""
# Prisma CLI only. Set an absolute CA file path in the shell/CI before starting Node.
NODE_EXTRA_CA_CERTS="<absolute-path-to-supabase-ca.crt>"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=verify-full"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
NEXT_PUBLIC_LEGAL_EMAIL=""
NEXT_PUBLIC_LEGAL_REVIEWED=""
SAAS3D_LOCAL_DEV=""
